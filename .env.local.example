NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. REQUIRED: every write to profiles.showcase (the Customise
# modal, achievement pins, the XP ratchet) goes through the privileged RPC
# set_profile_showcase, and account deletion uses auth.admin.deleteUser. Never
# expose client-side. Without it, profile saves fail with a clear 500.
# Use the secret key (sb_secret_...) from Settings > API Keys. The legacy
# service_role JWT still works until end of 2026 via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
TMDB_READ_TOKEN=
# Canonical site origin (no trailing slash). Defaults to https://www.movieranker.win
# when unset. Set this on preview deploys so share links and OG images resolve
# to the preview host instead of production.
# NEXT_PUBLIC_SITE_URL=
# Owner email allowed to approve shortlist proposals at /admin. Unset = feature dormant (admin routes 404).
OWNER_EMAIL=
# Google Analytics measurement ID (optional).
NEXT_PUBLIC_GA_ID=
